<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración del proyecto de QA (Fase 3). Igual a phpunit.xml de Firefly,
  salvo dos cosas:
  - SQLite en memoria: cada proceso de paratest tiene su propia base, así las
    pruebas se ejecutan en simultáneo sin pisarse las migraciones.
  - Sin cobertura ni stopOnFailure: queremos el resultado de todas las pruebas.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_TIMEZONE" value="America/Costa_Rica" force="true"/>
        <env name="TZ" value="America/Costa_Rica" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="APP_LOG_LEVEL" value="notice"/>
        <env name="AUDIT_LOG_LEVEL" value="emergency"/>
        <env name="QUERY_PARSER_IMPLEMENTATION" value="new"/>
    </php>
    <testsuites>
        <testsuite name="qa">
            <directory suffix="Test.php">./tests/qa</directory>
        </testsuite>
        <testsuite name="unit">
            <directory suffix="Test.php">./tests/unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
