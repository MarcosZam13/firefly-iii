<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC-P-08 (FF-TC-55) Transacciones concurrentes sobre la misma cuenta.
  Un mismo usuario (qa-perf-001) y una misma cuenta ("QA Perf Concurrencia"):
  1. setUp: GET /api/v1/accounts/{id} guarda el saldo inicial.
  2. 50 hilos x 10 gastos de 1.00 en simultáneo (Synchronizing Timer libera los 50 juntos
     en cada vuelta): POST /api/v1/transactions, aserción de código 200.
  3. tearDown: GET /api/v1/accounts/{id} y aserción de que el saldo final es exactamente
     saldo inicial - (gastos aceptados x 1.00) y de que se aceptaron los 500.
  Token y cuenta: resultados/concurrencia.properties (preparar-transacciones.sh).
  Criterio: 0 % de error, saldo final exacto (sin actualizaciones perdidas ni duplicadas).
  Uso (desde qa/rendimiento): sh correr-jmeter.sh tc-p-08
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="TC-P-08 Transacciones concurrentes sobre la misma cuenta">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
          </elementProp>
          <elementProp name="PUERTO" elementType="Argument">
            <stringProp name="Argument.name">PUERTO</stringProp>
            <stringProp name="Argument.value">${__P(puerto,8080)}</stringProp>
          </elementProp>
          <elementProp name="TOKEN" elementType="Argument">
            <stringProp name="Argument.name">TOKEN</stringProp>
            <stringProp name="Argument.value">${__P(token,SIN_TOKEN)}</stringProp>
          </elementProp>
          <elementProp name="CUENTA_C" elementType="Argument">
            <stringProp name="Argument.name">CUENTA_C</stringProp>
            <stringProp name="Argument.value">${__P(cuenta,0)}</stringProp>
          </elementProp>
          <elementProp name="ESPERADAS" elementType="Argument">
            <stringProp name="Argument.name">ESPERADAS</stringProp>
            <stringProp name="Argument.value">${__jexl3(${__P(hilos,50)} * ${__P(vueltas,10)})}</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Firefly III">
        <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
        <stringProp name="HTTPSampler.port">${PUERTO}</stringProp>
        <stringProp name="HTTPSampler.protocol">http</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Token de API y JSON">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Authorization</stringProp>
            <stringProp name="Header.value">Bearer ${TOKEN}</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp: saldo inicial">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET cuenta (saldo inicial)">
          <stringProp name="HTTPSampler.path">/api/v1/accounts/${CUENTA_C}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
        <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código 200">
          <collectionProp name="Asserion.test_strings">
            <stringProp name="c200">200</stringProp>
          </collectionProp>
          <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
          <boolProp name="Assertion.assume_success">false</boolProp>
          <intProp name="Assertion.test_type">8</intProp>
        </ResponseAssertion>
        <hashTree/>
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Guardar saldo inicial">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">props.put('saldo_inicial', new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).data.attributes.current_balance)
props.put('exitos', new java.util.concurrent.atomic.AtomicInteger())
log.info('TC-P-08 saldo inicial ' + props.get('saldo_inicial'))</stringProp>
        </JSR223PostProcessor>
        <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="50 hilos x 10 gastos sobre la misma cuenta">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(vueltas,10)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(hilos,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Liberar los hilos juntos">
          <stringProp name="groupSize">${__P(hilos,50)}</stringProp>
          <stringProp name="timeoutInMs">10000</stringProp>
        </SyncTimer>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/v1/transactions (misma cuenta)">
          <stringProp name="HTTPSampler.path">/api/v1/transactions</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"error_if_duplicate_hash": false, "apply_rules": false, "fire_webhooks": false, "transactions": [{"type": "withdrawal", "date": "2026-11-01", "amount": "1.00", "description": "QA TC-P-08 ${__threadNum}-${__counter(FALSE)}", "source_id": "${CUENTA_C}", "destination_name": "Comercio QA rendimiento"}]}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
        <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código 200">
          <collectionProp name="Asserion.test_strings">
            <stringProp name="c200">200</stringProp>
          </collectionProp>
          <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
          <boolProp name="Assertion.assume_success">false</boolProp>
          <intProp name="Assertion.test_type">8</intProp>
        </ResponseAssertion>
        <hashTree/>
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Contar gastos aceptados">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">if (prev.getResponseCode() == '200') {
    props.putIfAbsent('exitos', new java.util.concurrent.atomic.AtomicInteger())
    props.get('exitos').incrementAndGet()
}</stringProp>
        </JSR223PostProcessor>
        <hashTree/>
        </hashTree>
      </hashTree>
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown: verificar saldo final">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </PostThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET cuenta (saldo final)">
          <stringProp name="HTTPSampler.path">/api/v1/accounts/${CUENTA_C}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
        <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código 200">
          <collectionProp name="Asserion.test_strings">
            <stringProp name="c200">200</stringProp>
          </collectionProp>
          <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
          <boolProp name="Assertion.assume_success">false</boolProp>
          <intProp name="Assertion.test_type">8</intProp>
        </ResponseAssertion>
        <hashTree/>
        <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Saldo final = inicial - aceptados">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.math.BigDecimal
def inicial = new BigDecimal(props.get('saldo_inicial') ?: 'NaN')
def exitos = (props.get('exitos') ?: new java.util.concurrent.atomic.AtomicInteger()).get()
def esperadas = Integer.parseInt(vars.get('ESPERADAS'))
def finalSaldo = new BigDecimal(new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).data.attributes.current_balance)
def esperado = inicial.subtract(new BigDecimal(exitos))
log.info("TC-P-08 saldo inicial ${inicial}, gastos aceptados ${exitos} de ${esperadas}, saldo final ${finalSaldo}, esperado ${esperado}")
if (exitos != esperadas) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Solo ${exitos} de ${esperadas} gastos fueron aceptados")
} else if (finalSaldo.compareTo(esperado) != 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Saldo final ${finalSaldo}, esperado ${esperado} (inicial ${inicial} - ${exitos} x 1.00)")
}</stringProp>
        </JSR223Assertion>
        <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
