<?xml version='1.0' encoding='utf-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="TC-P-03 Consulta de presupuesto">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments" />
      </elementProp>
    </TestPlan>
    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Leer usuarios de prueba">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">1</intProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Preparar usuarios">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def file = new File(props.getProperty('usuarios', 'usuarios.csv'))
def lines = file.readLines('UTF-8').findAll { it.trim() }
if (lines[0].replace('\uFEFF','') != 'token,budget_id,limit_id') throw new IllegalArgumentException('Cabecera CSV incorrecta')
def rows = lines.drop(1).collect { it.split(',', -1) }
int threads = Integer.parseInt(props.getProperty('hilos', '50'))
if (rows.size() &lt; threads) throw new IllegalArgumentException('Faltan usuarios distintos para la carga')
props.put('qaPresupuestos', rows)
</stringProp>
        </JSR223Sampler>
        <hashTree />
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="50 usuarios durante 120 segundos">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(hilos,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampa,15)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duracion,120)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Autenticacion y respuesta JSON">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${TOKEN}</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree />
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Un usuario fijo por hilo">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def row = props.get('qaPresupuestos')[ctx.getThreadNum()]
vars.put('TOKEN', row[0]); vars.put('BUDGET_ID', row[1]); vars.put('LIMIT_ID', row[2])</stringProp>
        </JSR223PreProcessor>
        <hashTree />
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET presupuesto">
          <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(puerto,8081)}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/budgets/${BUDGET_ID}/limits/${LIMIT_ID}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments" />
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="HTTP 200 y limite del usuario">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
  def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
  boolean ok = prev.getResponseCode() == '200' &amp;&amp; json.data.id.toString() == vars.get('LIMIT_ID') &amp;&amp; json.data.attributes.budget_id.toString() == vars.get('BUDGET_ID') &amp;&amp; json.data.attributes.amount != null &amp;&amp; json.data.attributes.spent instanceof List
  if (!ok) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Respuesta o presupuesto incorrectos') }
} catch (Exception e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Respuesta JSON invalida') }</stringProp>
          </JSR223Assertion>
          <hashTree />
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>